# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# ---------------- LLM (model-agnostic) ----------------
# LLM_PROVIDER is any LangChain chat-model provider: openai | anthropic | google_genai | bedrock_converse | ollama
# LLM_PROVIDER=rules runs the whole pipeline with deterministic fallbacks and no model (for tests / offline).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
# LLM_MAX_TOKENS=1500                # output cap per LLM call
# LLM_TIMEOUT_SECONDS=90             # per-call timeout; on timeout the node falls back to rules
# LLM_TEMPERATURE=0                  # optional; not sent unless set (current Claude models reject it)
# LLM_BASE_URL=                      # optional: OpenAI-compatible proxy, or a remote Ollama host

# Examples:
#   LLM_PROVIDER=anthropic   LLM_MODEL=claude-haiku-5-5     (or claude-sonnet-5-5)
#   LLM_PROVIDER=ollama      LLM_MODEL=qwen3:14b          (local, no key)
#   LLM_PROVIDER=google_genai LLM_MODEL=gemini-2.5-flash  (pip install langchain-google-genai)

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---------------- Embeddings / index ----------------
# local  = all-MiniLM-L6-v2 via onnxruntime (no key)   | ollama (EMBEDDING_MODEL=nomic-embed-text) | openai
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=
# CATEGORY_REGEX=Toys & Games|Home & Kitchen      # optional: index only a category slice
# RAG_STRONG_SIM=0.45                             # relevance thresholds (calibrated for the local model)
# RAG_WEAK_SIM=0.35

# ---------------- web.search (MCP tool) ----------------
# brave | serper | tavily | fixture (canned TEST data in eval/fixtures, for tests and evaluation only) | none
WEB_SEARCH_PROVIDER=none
BRAVE_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
WEB_CACHE_TTL_SECONDS=180
WEB_RATE_LIMIT_PER_MIN=20
# WEB_ALLOWED_DOMAINS=amazon.com,walmart.com,target.com    # optional allow-list
# WEB_BLOCKED_DOMAINS=

# ---------------- Speech ----------------
# ASR: faster_whisper (local; ASR_MODEL=base.en | small.en | medium) or openai (ASR_MODEL=whisper-1)
ASR_PROVIDER=faster_whisper
ASR_MODEL=base.en
# ASR_DEVICE=cuda
# TTS: pyttsx3 (offline system voice) or openai (TTS_MODEL=gpt-4o-mini-tts, TTS_VOICE=alloy)
TTS_PROVIDER=pyttsx3
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=

# ---------------- MCP ----------------
# stdio: the agent spawns the server as a subprocess. http: connect to a server started with scripts/run_mcp
MCP_TRANSPORT=stdio
# MCP_URL=http://127.0.0.1:8765/mcp

# ---------------- ProofAgent evaluation ----------------
# Harness (judge) model, any LiteLLM target. Use a strong model; it is separate from the agent's LLM.
PROOFAGENT_LLM=anthropic/claude-haiku-5-5
# PROOFAGENT_LLM=anthropic/claude-sonnet-5-5   (stronger judge, more reliable scores)
# PROOFAGENT_LLM=ollama_chat/qwen3:14b     (local smoke run; scores are noisy)
# PROOFAGENT_REASONING_EFFORT=none           (set for local reasoning models to switch thinking off)
# LLM_SEED=42                        # sampling seed (OpenAI, Ollama) for repeatable runs; empty to disable
# LLM_STRUCTURED_MODE=                # forced | auto (default: auto for Claude, forced otherwise)
# PROOFAGENT_FALLBACK_LLM=anthropic/claude-sonnet-5-5   (retries juror calls the primary judge returned as invalid JSON)
